SERVER_PORT=8080
# Opcional: use DB_URL para informar a string JDBC completa.
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=AgendaBanda;encrypt=true;trustServerCertificate=true
# Exemplo para instancia nomeada:
# DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=AgendaBanda;encrypt=true;trustServerCertificate=true
DB_HOST=localhost
DB_PORT=1433
DB_NAME=AgendaBanda
DB_USER=agenda_user
DB_PASSWORD=agenda123
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Limites por IP e por alvo, separados por fluxo; teto global por instancia.
AUTH_LOGIN_LIMITE=20
AUTH_LOGIN_LIMITE_GLOBAL=200
AUTH_LOGIN_JANELA_MINUTOS=15
AUTH_CADASTRO_LIMITE=5
AUTH_CADASTRO_LIMITE_GLOBAL=50
AUTH_CADASTRO_JANELA_MINUTOS=60
AUTH_RECUPERACAO_LIMITE=10
AUTH_RECUPERACAO_LIMITE_GLOBAL=100
AUTH_RECUPERACAO_JANELA_MINUTOS=15
# Prazos contados no horario de Sao Paulo.
AUTH_RECUPERACAO_PENDENTE_HORAS=24
AUTH_RECUPERACAO_APROVADA_HORAS=2
AUTH_RECUPERACAO_VARREDURA_MS=60000
# Intervalo da limpeza de sessoes expiradas.
AUTH_SESSAO_VARREDURA_MS=60000
